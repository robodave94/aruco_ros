<?xml version="1.0"?>
<launch>
    <!-- ArUco RT Capture Launch File -->
    <!-- Real-time ArUco marker detection from an RGB image topic -->

    <arg name="image_topic" default="/camera/image_raw"
         description="Input RGB image topic"/>

    <arg name="dictionaries" default="['DICT_6X6_250']"
         description="List of ArUco dictionary names"/>

    <arg name="marker_sizes" default="[0.05]"
         description="List of marker sizes in meters"/>

    <arg name="camera_info_topic" default="/camera/camera_info"
         description="Camera info topic providing intrinsics and distortion"/>

    <node pkg="aruco_ros_cv" exec="aruco_rt_capture"
          name="aruco_rt_capture" output="screen">
        <param name="image_topic" value="$(var image_topic)"/>
        <param name="dictionaries" value="$(var dictionaries)"/>
        <param name="marker_sizes" value="$(var marker_sizes)"/>
        <param name="camera_info_topic" value="$(var camera_info_topic)"/>
    </node>
</launch>
