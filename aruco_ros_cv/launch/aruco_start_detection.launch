<?xml version="1.0"?>
<launch>
    <!-- Sends a start_detection goal to aruco_action_server without hand-writing the CLI call -->

    <arg name="action_server_name" default="aruco_action_server"
         description="Name of the aruco_action_server node"/>

    <arg name="image_topic" default="/camera/image_raw"
         description="Camera image topic to start detection on"/>

    <arg name="dictionaries" default="['DICT_6X6_250']"
         description="List of ArUco dictionary names"/>

    <arg name="marker_sizes" default="[0.05]"
         description="List of marker sizes in meters, parallel to dictionaries"/>

    <arg name="camera_params_file"
         default="$(find-pkg-share aruco_ros_cv)/resources/camera_params.yml"
         description="Path to an OpenCV YAML camera intrinsics file"/>

    <arg name="detection_id" default=""
         description="Optional id for this detection (default: auto-generated from dictionaries)"/>

    <arg name="reference_frame" default=""
         description="TF parent frame for broadcast marker transforms (empty => image frame_id)"/>

    <arg name="zoom_enabled" default="false"
         description="Crop + upscale the frame before detection to help see small markers"/>
    <arg name="zoom_center_x" default="-1.0"
         description="Crop center x in px (&lt;0 => image principal point)"/>
    <arg name="zoom_center_y" default="-1.0"
         description="Crop center y in px (&lt;0 => image principal point)"/>
    <arg name="zoom_width" default="500.0" description="Crop width in px"/>
    <arg name="zoom_height" default="500.0" description="Crop height in px"/>
    <arg name="zoom_upscale" default="1.5" description="Upscale factor applied to the crop"/>
    <arg name="zoom_rescale_distortion" default="false"
         description="Undistort the crop before detection (default false)"/>
    <arg name="zoom_debug_enabled" default="false"
         description="Also publish the upscaled-crop debug feed (default false)"/>

    <node pkg="aruco_ros_cv" exec="aruco_start_detection"
          name="aruco_start_detection" output="screen">
        <param name="action_server_name" value="$(var action_server_name)"/>
        <param name="image_topic" value="$(var image_topic)"/>
        <param name="dictionaries" value="$(var dictionaries)"/>
        <param name="marker_sizes" value="$(var marker_sizes)"/>
        <param name="camera_params_file" value="$(var camera_params_file)"/>
        <param name="detection_id" value="$(var detection_id)"/>
        <param name="reference_frame" value="$(var reference_frame)"/>
        <param name="zoom_enabled" value="$(var zoom_enabled)"/>
        <param name="zoom_center_x" value="$(var zoom_center_x)"/>
        <param name="zoom_center_y" value="$(var zoom_center_y)"/>
        <param name="zoom_width" value="$(var zoom_width)"/>
        <param name="zoom_height" value="$(var zoom_height)"/>
        <param name="zoom_upscale" value="$(var zoom_upscale)"/>
        <param name="zoom_rescale_distortion" value="$(var zoom_rescale_distortion)"/>
        <param name="zoom_debug_enabled" value="$(var zoom_debug_enabled)"/>
    </node>
</launch>
